PORT=3001
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# true sirve frontend/dist y la API desde la misma URL. Compila el frontend antes.
SERVE_FRONTEND=false

# --- Correo saliente ---
# Necesario en producción para verificar cuentas y recuperar contraseñas.
MAIL_TRANSPORT=smtp
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false.
# SMTP_PASS debe ser una contraseña de aplicación de Google, no la clave normal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Alternativa por HTTPS: MAIL_TRANSPORT=gmail-api.
# El remitente debe autorizar una vez el permiso gmail.send vía OAuth.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

# --- Administrador y avisos de registro ---
# Recibe un correo por cada cuenta nueva y sirve para promover tu cuenta
# verificada con: ADMIN_EMAIL=tu-correo npm run seed:admin
ADMIN_EMAIL=

# --- WhatsApp Business Cloud API (Meta) ---
# Opcional. Deja las credenciales vacías para usar WhatsApp manual desde la agenda.
# Requiere número de WhatsApp Business habilitado, token permanente y plantillas aprobadas.
# Las cinco plantillas usan 7 variables body, en este orden: cliente, negocio,
# servicio, fecha, hora inicio, hora fin y ubicación.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=es_CO
WHATSAPP_TEMPLATE_BOOKING_OWNER=
WHATSAPP_TEMPLATE_BOOKING_CLIENT=
WHATSAPP_TEMPLATE_CONFIRMED_CLIENT=
WHATSAPP_TEMPLATE_REMINDER_CLIENT=
WHATSAPP_TEMPLATE_CANCELLED_CLIENT=

# --- Validación de correo en el registro ---
# true  => obligatoria: el registro pide un código de 6 dígitos y el login
#         queda bloqueado hasta verificarlo (necesita SMTP_* configurados).
# false => solo para desarrollo local.
REQUIRE_EMAIL_VERIFICATION=true
